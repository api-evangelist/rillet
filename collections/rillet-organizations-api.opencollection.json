{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rillet Accounting API Key Organizations API",
    "version": "v4.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rillet.com/organizations/self"
          },
          "docs": "Returns the organization profile for the API credentials in use (the “current” org).\nUse this to confirm organization id, display name, and other org-level settings in integrations.\n"
        }
      ]
    }
  ],
  "bundled": true
}