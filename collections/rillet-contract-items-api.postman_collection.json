          "name": "Deletes a usage record",
          "request": {
            "name": "Deletes a usage record",
            "description": {
              "content": "Removes the usage entry for a single contract item on a specific calendar date.\nThis is narrower than upsert-a-usage-record and is ideal when you need to wipe a mistaken day without resending the entire usage payload.\n",
              "type": "text/plain"
            },
            "url": {
